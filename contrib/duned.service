[Unit]
Description=dune VM daemon
Documentation=https://github.com/rrhubenov/dune
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/duned
Restart=on-failure
RestartSec=2
# VMs run in their own scopes (dune-vm-<id>.scope in dune.slice), not in
# this unit's cgroup, so stopping or restarting duned leaves them running.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
